generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  NEGOTIATION
  CONFIRMED
  REJECTED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Inquiry {
  id                String                  @id @default(cuid())

  /// Human-readable inquiry number
  inquiryNumber     String                  @unique

  companyName       String
  contactPerson     String

  email             String
  phone             String?

  country           String

  /// Product name submitted by customer
  product           String

  quantity          String?
  unit              String?

  message           String

  status            InquiryStatus           @default(NEW)
  priority          InquiryPriority         @default(MEDIUM)

  /// Source of inquiry
  source            String?                 @default("Website")

  /// Request metadata
  ipAddress         String?
  userAgent         String?

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  // Relations
  statusHistory     InquiryStatusHistory[]
  notes             InquiryNote[]

  @@index([inquiryNumber])
  @@index([email])
  @@index([status])
  @@index([country])
  @@index([product])
  @@index([createdAt])
}

model InquiryStatusHistory {
  id            String          @id @default(cuid())

  inquiryId     String
  inquiry       Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  oldStatus     InquiryStatus?
  newStatus     InquiryStatus

  changedById   String?
  changedBy     Admin?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())

  @@index([inquiryId])
  @@index([createdAt])
}

model InquiryNote {
  id            String          @id @default(cuid())

  inquiryId     String
  inquiry       Inquiry         @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  note          String          @db.Text

  createdById   String?
  createdBy     Admin?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([inquiryId])
  @@index([createdAt])
}

model Admin {
  id                String                    @id @default(cuid())

  name              String

  email             String                    @unique

  password          String

  role              AdminRole                 @default(SUPER_ADMIN)

  isActive          Boolean                   @default(true)

  lastLogin         DateTime?

  createdAt         DateTime                  @default(now())

  updatedAt         DateTime                  @updatedAt

  // Relations
  inquiryNotes      InquiryNote[]
  statusChanges     InquiryStatusHistory[]
}