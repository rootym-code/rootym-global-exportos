generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WhatsAppMessage {
  id                  String                @id @default(cuid())
  inquiryId           String
  message             String
  status              WhatsAppMessageStatus @default(DRAFT)
  approvedAt          DateTime?
  sentAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  approvedBy          String?
  deliveredAt         DateTime?
  direction           MessageDirection      @default(OUTBOUND)
  errorMessage        String?
  externalId          String?
  failedAt            DateTime?
  queuedAt            DateTime?
  readAt              DateTime?
  whatsAppAttachments WhatsAppAttachment[]
  inquiry             Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([status])
  @@index([direction])
  @@index([externalId])
}

model Inquiry {
  id               String                 @id @default(cuid())
  companyName      String
  contactPerson    String
  email            String
  phone            String?
  country          String
  /// Product name submitted by customer
  product          String
  quantity         String?
  message          String
  status           InquiryStatus          @default(NEW)
  priority         InquiryPriority        @default(MEDIUM)
  /// Source of inquiry
  source           String?                @default("Website")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  /// Human-readable inquiry number
  inquiryNumber    String                 @unique
  /// Request metadata
  ipAddress        String?
  unit             String?
  userAgent        String?
  salesStage       SalesStage             @default(NEW)
  followUps        FollowUp[]
  notes            InquiryNote[]
  statusHistory    InquiryStatusHistory[]
  quotes           Quote[]
  whatsappMessages WhatsAppMessage[]

  @@index([inquiryNumber])
  @@index([email])
  @@index([status])
  @@index([salesStage])
  @@index([country])
  @@index([product])
  @@index([createdAt])
}

model InquiryStatusHistory {
  id          String         @id @default(cuid())
  inquiryId   String
  oldStatus   InquiryStatus?
  newStatus   InquiryStatus
  changedById String?
  createdAt   DateTime       @default(now())
  changedBy   Admin?         @relation(fields: [changedById], references: [id])
  inquiry     Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
}

/**
 * ============================================================
 * ROOTYM ExportOS
 * ============================================================
 * Author: Prem Singh
 * Purpose: Stores administrator-controlled billing provider
 * availability for each ROOTYM deployment environment.
 * Provider credentials are intentionally NOT stored here.
 * Credentials remain deployment secrets/environment variables.
 * This model controls provider availability only.
 * ============================================================
 */

enum BillingEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

/**
 * ============================================================
 * Billing Provider Configuration
 * ============================================================
 * One provider may be configured independently for each
 * environment.
 * Examples:
 * DEVELOPMENT + TEST       + enabled
 * DEVELOPMENT + RAZORPAY   + disabled
 * STAGING     + TEST       + enabled
 * STAGING     + RAZORPAY   + enabled
 * PRODUCTION  + RAZORPAY   + enabled
 * PRODUCTION  + TEST       + disabled
 * The provider field remains String rather than a Prisma enum
 * so adding future providers does not require a database enum
 * migration.
 * ============================================================
 */

model BillingProviderConfig {
  id String @id @default(cuid())

  environment BillingEnvironment

  /**
   * Provider registry key.
   * Examples:
   * TEST
   * RAZORPAY
   * STRIPE
   * PAYPAL
   */
  provider String

  /**
   * Administrator-controlled availability.
   */
  enabled Boolean @default(false)

  /**
   * Optional administrator-facing display name.
   */
  displayName String?

  /**
   * Controls ordering in the customer billing UI.
   */
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([environment, provider])
  @@index([environment])
  @@index([environment, enabled])
  @@index([provider])
}

model InquiryNote {
  id          String   @id @default(cuid())
  inquiryId   String
  note        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Admin?   @relation(fields: [createdById], references: [id])
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
}

model WhatsAppAttachment {
  id                String          @id @default(cuid())
  whatsappMessageId String
  mediaId           String
  createdAt         DateTime        @default(now())
  media             Media           @relation(fields: [mediaId], references: [id])
  whatsappMessage   WhatsAppMessage @relation(fields: [whatsappMessageId], references: [id], onDelete: Cascade)

  @@index([whatsappMessageId])
  @@index([mediaId])
}

model Admin {
  id                 String                 @id @default(cuid())
  name               String
  email              String                 @unique
  password           String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  isActive           Boolean                @default(true)
  lastLogin          DateTime?
  role               AdminRole              @default(SUPER_ADMIN)
  activities         Activity[]             @relation("ActivityPerformedBy")
  assignedFollowUps  FollowUp[]             @relation("AssignedFollowUps")
  completedFollowUps FollowUp[]             @relation("CompletedFollowUps")
  inquiryNotes       InquiryNote[]
  statusChanges      InquiryStatusHistory[]
  createdQuotes      Quote[]                @relation("QuoteCreatedBy")
  updatedQuotes      Quote[]                @relation("QuoteUpdatedBy")
}

model FollowUp {
  id               String             @id @default(cuid())
  inquiryId        String
  assignedToId     String?
  completedById    String?
  sequence         Int                @default(1)
  title            String
  description      String?
  notes            String?
  actionType       FollowUpActionType
  category         FollowUpCategory
  priority         FollowUpPriority   @default(MEDIUM)
  status           FollowUpStatus     @default(PENDING)
  result           FollowUpResult?
  scheduledAt      DateTime
  dueAt            DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  parentFollowUpId String?
  assignedTo       Admin?             @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  completedBy      Admin?             @relation("CompletedFollowUps", fields: [completedById], references: [id])
  inquiry          Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  parentFollowUp   FollowUp?          @relation("FollowUpChain", fields: [parentFollowUpId], references: [id])
  childFollowUps   FollowUp[]         @relation("FollowUpChain")

  @@index([inquiryId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledAt])
  @@index([priority])
  @@index([category])
  @@index([parentFollowUpId])
}

model Product {
  id                   String                @id @default(cuid())
  sku                  String                @unique
  name                 String
  slug                 String                @unique
  shortDescription     String?
  description          String?
  category             String?
  origin               String?
  hsCode               String?
  defaultUnit          String
  minOrderQty          Decimal?              @db.Decimal(18, 3)
  maxOrderQty          Decimal?              @db.Decimal(18, 3)
  status               ProductStatus         @default(DRAFT)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  featuredImageId      String?
  featuredImage        Media?                @relation("ProductFeaturedImage", fields: [featuredImageId], references: [id])
  pricing              ProductPricing[]
  proformaInvoiceItems ProformaInvoiceItem[]
  quoteItems           QuoteItem[]

  @@index([status])
  @@index([category])
  @@index([name])
  @@index([featuredImageId])
}

model ProductPricing {
  id          String      @id @default(cuid())
  productId   String
  pricingType PricingType @default(FIXED)
  currency    String
  price       Decimal     @db.Decimal(18, 2)
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean     @default(true)
  remarks     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
}

model Quote {
  id              String           @id @default(cuid())
  quoteNumber     String           @unique
  inquiryId       String?
  companyName     String
  contactPerson   String
  email           String
  phone           String?
  country         String
  currency        String
  subtotal        Decimal          @default(0) @db.Decimal(18, 2)
  discount        Decimal          @default(0) @db.Decimal(18, 2)
  freight         Decimal          @default(0) @db.Decimal(18, 2)
  insurance       Decimal          @default(0) @db.Decimal(18, 2)
  tax             Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal          @default(0) @db.Decimal(18, 2)
  validityDays    Int              @default(15)
  status          QuoteStatus      @default(DRAFT)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  parentQuoteId   String?
  validUntil      DateTime?
  version         Int              @default(1)
  proformaInvoice ProformaInvoice?
  createdBy       Admin?           @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  inquiry         Inquiry?         @relation(fields: [inquiryId], references: [id])
  parentQuote     Quote?           @relation("QuoteRevisions", fields: [parentQuoteId], references: [id])
  revisions       Quote[]          @relation("QuoteRevisions")
  updatedBy       Admin?           @relation("QuoteUpdatedBy", fields: [updatedById], references: [id])
  items           QuoteItem[]

  @@index([quoteNumber])
  @@index([status])
  @@index([companyName])
  @@index([country])
  @@index([createdById])
  @@index([updatedById])
  @@index([parentQuoteId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String
  description String?
  quantity    Decimal  @db.Decimal(18, 3)
  unit        String
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([productId])
}

model ProformaInvoice {
  id             String                @id @default(cuid())
  piNumber       String                @unique
  quoteId        String                @unique
  issueDate      DateTime              @default(now())
  paymentDueDate DateTime?
  companyName    String
  contactPerson  String
  email          String
  phone          String?
  country        String
  currency       String
  subtotal       Decimal               @default(0) @db.Decimal(18, 2)
  discount       Decimal               @default(0) @db.Decimal(18, 2)
  freight        Decimal               @default(0) @db.Decimal(18, 2)
  insurance      Decimal               @default(0) @db.Decimal(18, 2)
  tax            Decimal               @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal               @default(0) @db.Decimal(18, 2)
  paymentTerms   String?
  incoterms      String?
  notes          String?
  status         ProformaInvoiceStatus @default(DRAFT)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  quote          Quote                 @relation(fields: [quoteId], references: [id])
  items          ProformaInvoiceItem[]

  @@index([quoteId])
  @@index([status])
  @@index([companyName])
  @@index([country])
  @@index([issueDate])
}

model ProformaInvoiceItem {
  id                String          @id @default(cuid())
  proformaInvoiceId String
  productId         String
  description       String?
  quantity          Decimal         @db.Decimal(18, 3)
  unit              String
  unitPrice         Decimal         @db.Decimal(18, 2)
  lineTotal         Decimal         @db.Decimal(18, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  product           Product         @relation(fields: [productId], references: [id])
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)

  @@index([proformaInvoiceId])
  @@index([productId])
}

model Activity {
  id            String             @id @default(cuid())
  /// Business entity type
  entityType    ActivityEntityType
  /// Entity primary key
  entityId      String
  /// Human-readable reference
  /// Examples:
  /// INQ-2026-000001
  /// QT-2026-000001
  entityNumber  String?
  /// Machine readable event
  action        String
  /// UI friendly title
  title         String
  /// Detailed description
  description   String?
  /// Additional event metadata
  metadata      Json?
  /// Who performed the action
  actorType     ActivityActorType  @default(ADMIN)
  /// Admin user (nullable for System / AI / Customer)
  performedById String?
  createdAt     DateTime           @default(now())
  performedBy   Admin?             @relation("ActivityPerformedBy", fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([entityNumber])
  @@index([action])
  @@index([actorType])
  @@index([performedById])
  @@index([createdAt])
}

model NumberSequence {
  id        String             @id @default(cuid())
  type      NumberSequenceType
  year      Int
  lastValue Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([type, year])
  @@index([type])
  @@index([year])
}

model Language {
  id               String               @id @default(cuid())
  /// ISO language code (en, hi, ar, fr)
  code             String               @unique
  /// Display name
  name             String
  /// Native language name
  nativeName       String?
  /// Default language
  isDefault        Boolean              @default(false)
  /// Active language
  isActive         Boolean              @default(true)
  /// Display order
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  pageTranslations CmsPageTranslation[]

  @@index([isActive])
  @@index([sortOrder])
}

model CmsPage {
  id              String               @id @default(cuid())
  /// Internal page title
  title           String
  /// URL slug
  slug            String               @unique
  /// Page status
  status          CmsPageStatus        @default(DRAFT)
  /// Homepage flag
  isHomePage      Boolean              @default(false)
  /// Navigation visibility
  showInMenu      Boolean              @default(true)
  /// SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  /// Publishing
  publishedAt     DateTime?
  /// Audit
  createdById     String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  /// Page rendering template
  template        CmsPageTemplate      @default(STANDARD)
  /// Public page presentation shell
  layout          CmsPageLayout        @default(WEBSITE)
  translations    CmsPageTranslation[]
  menuItems       MenuItem[]

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([showInMenu])
}

model CmsPageTranslation {
  id                String   @id @default(cuid())
  pageId            String
  languageId        String
  /// Localized page content
  title             String
  slug              String
  excerpt           String?
  content           String?
  /// SEO
  metaTitle         String?
  metaDescription   String?
  metaKeywords      String?
  /// Publishing
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// Structured CMS landing-page content
  structuredContent Json?
  language          Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  page              CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, languageId])
  @@unique([languageId, slug])
  @@index([pageId])
  @@index([languageId])
  @@index([slug])
  @@index([isPublished])
}

model Media {
  id                  String               @id @default(cuid())
  /// Original filename
  fileName            String
  /// Stored filename
  storedFileName      String
  /// Public URL or relative path
  fileUrl             String
  /// Storage provider (local, s3, cloudinary, etc.)
  storageProvider     String?              @default("local")
  /// MIME type
  mimeType            String?
  /// IMAGE / VIDEO / DOCUMENT / AUDIO / OTHER
  mediaType           MediaType
  /// File size in bytes
  fileSize            Int?
  /// Image dimensions
  width               Int?
  height              Int?
  /// Optional alt text
  altText             String?
  /// Optional title
  title               String?
  /// Optional description
  description         String?
  /// Folder/category
  folder              String?
  /// Soft delete
  isDeleted           Boolean              @default(false)
  /// Audit
  uploadedById        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  featuredInProducts  Product[]            @relation("ProductFeaturedImage")
  whatsAppAttachments WhatsAppAttachment[]

  @@index([mediaType])
  @@index([folder])
  @@index([isDeleted])
  @@index([createdAt])
}

model Menu {
  id          String     @id @default(cuid())
  /// Internal menu name
  name        String
  /// Unique menu identifier
  code        String     @unique
  /// Description
  description String?
  /// Active menu
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@index([isActive])
}

model MenuItem {
  id           String     @id @default(cuid())
  menuId       String
  /// Parent item for dropdowns
  parentId     String?
  /// Display label
  label        String
  /// URL
  url          String
  /// Optional linked CMS page
  pageId       String?
  /// Display order
  sortOrder    Int        @default(0)
  /// Open in new tab
  openInNewTab Boolean    @default(false)
  /// Visibility
  isVisible    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  page         CmsPage?   @relation(fields: [pageId], references: [id])
  parent       MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuHierarchy")

  @@index([menuId])
  @@index([parentId])
  @@index([pageId])
  @@index([sortOrder])
  @@index([isVisible])
}

model SiteSetting {
  id          String   @id @default(cuid())
  /// Unique configuration key
  key         String   @unique
  /// Configuration value
  value       String?
  /// Category (General, SEO, Contact, Social, etc.)
  category    String?
  /// Description for administrators
  description String?
  /// Data type
  /// text, number, boolean, json
  valueType   String   @default("text")
  /// Publicly accessible setting
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

model Redirect {
  id           String       @id @default(cuid())
  /// Old URL
  fromPath     String       @unique
  /// New URL
  toPath       String
  /// Permanent or Temporary
  redirectType RedirectType @default(PERMANENT)
  /// Active redirect
  isActive     Boolean      @default(true)
  /// Optional remarks
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([isActive])
  @@index([redirectType])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  DRAFT
  APPROVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  REJECTED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CLOSED
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpActionType {
  CALL
  WHATSAPP
  EMAIL
  QUOTATION
  MEETING
  SAMPLE
  PAYMENT
  DOCUMENTATION
  SHIPMENT
  OTHER
}

enum FollowUpResult {
  BUYER_RESPONDED
  NO_RESPONSE
  CALL_BACK_LATER
  QUOTE_SENT
  MEETING_DONE
  DEAL_CLOSED
  NOT_INTERESTED
  WRONG_NUMBER
}

enum FollowUpCategory {
  SALES
  NEGOTIATION
  PAYMENT
  DOCUMENTATION
  SHIPMENT
  GENERAL
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  NEGOTIATION
  CONFIRMED
  REJECTED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SalesStage {
  NEW
  QUALIFIED
  QUOTE_PREPARING
  QUOTE_SENT
  NEGOTIATION
  PO_RECEIVED
  ORDER_CONFIRMED
  CLOSED_WON
  CLOSED_LOST
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingType {
  FIXED
  MARKET
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  APPROVED
}

enum ActivityEntityType {
  INQUIRY
  QUOTE
  ORDER
  SHIPMENT
  PRODUCT
  CUSTOMER
  DOCUMENT
  FOLLOWUP
}

enum ActivityActorType {
  ADMIN
  CUSTOMER
  SYSTEM
  AI
}

enum NumberSequenceType {
  INQUIRY
  QUOTE
  ORDER
  SHIPMENT
  INVOICE
  CUSTOMER
  SUPPLIER
  PROFORMA_INVOICE
}

enum ProformaInvoiceStatus {
  DRAFT
  SENT
  PAYMENT_PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CmsPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CmsPageTemplate {
  STANDARD
  COUNTRY_LANDING
}

enum CmsPageLayout {
  WEBSITE
  STANDALONE
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum RedirectType {
  PERMANENT
  TEMPORARY
}

// -----------------------------------------------------------------------------
// ROOTYM SaaS Identity & Subscription Foundation
// Author: Prem Singh
// Purpose: Defines SaaS users, tenants, memberships, plans, and subscriptions.
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  identities  AuthIdentity[]
  memberships Membership[]

  @@index([isActive])
}

model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  subscriptions   Subscription[]
  planChanges     SubscriptionPlanChange[]
  billingCustomer BillingCustomer?
  payments        Payment[]

  @@index([isActive])
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([role])
}

/**
 * Author: Prem Singh
 * Purpose: Defines ROOTYM SaaS trial and paid billing plans used for subscription management.
 */

model Plan {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  type            PlanType        @default(PAID)
  billingInterval BillingInterval @default(MONTHLY)

  amount   Int    @default(0)
  currency String @default("INR")

  trialDays Int @default(0)

  razorpayPlanId String? @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions   Subscription[]
  planChangesFrom SubscriptionPlanChange[] @relation("PlanChangeFromPlan")
  planChangesTo   SubscriptionPlanChange[] @relation("PlanChangeToPlan")

  @@index([isActive])
  @@index([type])
  @@index([billingInterval])
  @@index([currency])
}

/**
 * Author: Prem Singh
 * Purpose: Stores the tenant subscription lifecycle and Razorpay billing references.
 */

model Subscription {
  id              String             @id @default(cuid())
  tenantId        String
  planId          String
  status          SubscriptionStatus @default(TRIALING)
  billingInterval BillingInterval?
  startedAt       DateTime           @default(now())

  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  canceledAt DateTime?

  amount   Int?
  currency String?

  razorpayCustomerId     String?
  razorpaySubscriptionId String? @unique

  razorpayStartAt      DateTime?
  razorpayEndAt        DateTime?
  razorpayCurrentStart DateTime?
  razorpayCurrentEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan Plan @relation(fields: [planId], references: [id])

  payments    Payment[]
  planChanges SubscriptionPlanChange[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([razorpayCustomerId])
}

/**
 * Author: Prem Singh
 * Purpose: Stores a paid future subscription plan change without changing the currently effective plan.
 */
model SubscriptionPlanChange {
  id                     String  @id @default(cuid())
  tenantId               String
  subscriptionId         String
  razorpaySubscriptionId String?
  fromPlanId             String
  toPlanId               String

  effectiveAt         DateTime
  upcomingPeriodStart DateTime?
  upcomingPeriodEnd   DateTime?

  razorpayStartAt      DateTime?
  razorpayEndAt        DateTime?
  razorpayCurrentStart DateTime?
  razorpayCurrentEnd   DateTime?

  status    PlanChangeStatus @default(PAYMENT_PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  fromPlan Plan @relation("PlanChangeFromPlan", fields: [fromPlanId], references: [id])

  toPlan Plan @relation("PlanChangeToPlan", fields: [toPlanId], references: [id])

  payments Payment[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([razorpaySubscriptionId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@index([effectiveAt])
  @@index([status])
}

/**
 * Author: Prem Singh
 * Purpose: Stores the Razorpay billing customer associated with a ROOTYM tenant.
 */

model BillingCustomer {
  id       String @id @default(cuid())
  tenantId String @unique

  provider           String @default("RAZORPAY")
  providerCustomerId String @unique

  email String?
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([provider])
}

/**
 * Author: Prem Singh
 * Purpose: Stores individual SaaS payment transactions received through Razorpay.
 */

model Payment {
  id String @id @default(cuid())

  tenantId       String
  subscriptionId String?
  planChangeId   String?

  provider String @default("RAZORPAY")

  providerPaymentId      String  @unique
  providerOrderId        String?
  providerInvoiceId      String?
  providerSubscriptionId String?

  amount   Int
  currency String @default("INR")

  status PaymentStatus @default(CREATED)

  paidAt   DateTime?
  failedAt DateTime?

  failureCode   String?
  failureReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  planChange SubscriptionPlanChange? @relation(fields: [planChangeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([planChangeId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerInvoiceId])
  @@index([providerSubscriptionId])
}

/**
 * Author: Prem Singh
 * Purpose: Provides idempotent storage and processing state for Razorpay webhook events.
 */

model BillingWebhookEvent {
  id String @id @default(cuid())

  provider  String @default("RAZORPAY")
  eventId   String @unique
  eventType String

  status BillingWebhookStatus @default(RECEIVED)

  payload Json

  processedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum PlanType {
  TRIAL
  PAID
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PlanChangeStatus {
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  APPLIED
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}
