generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WhatsAppMessage {
  id                  String                @id @default(cuid())
  inquiryId           String
  message             String
  status              WhatsAppMessageStatus @default(DRAFT)
  approvedAt          DateTime?
  sentAt              DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  approvedBy          String?
  deliveredAt         DateTime?
  direction           MessageDirection      @default(OUTBOUND)
  errorMessage        String?
  externalId          String?
  failedAt            DateTime?
  queuedAt            DateTime?
  readAt              DateTime?
  whatsAppAttachments WhatsAppAttachment[]
  inquiry             Inquiry               @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([status])
  @@index([direction])
  @@index([externalId])
}

model Inquiry {
  id               String                 @id @default(cuid())
  companyName      String
  contactPerson    String
  email            String
  phone            String?
  country          String
  /// Product name submitted by customer
  product          String
  quantity         String?
  message          String
  status           InquiryStatus          @default(NEW)
  priority         InquiryPriority        @default(MEDIUM)
  /// Source of inquiry
  source           String?                @default("Website")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  /// Human-readable inquiry number
  inquiryNumber    String                 @unique
  /// Request metadata
  ipAddress        String?
  unit             String?
  userAgent        String?
  salesStage       SalesStage             @default(NEW)
  followUps        FollowUp[]
  notes            InquiryNote[]
  statusHistory    InquiryStatusHistory[]
  quotes           Quote[]
  whatsappMessages WhatsAppMessage[]

  @@index([inquiryNumber])
  @@index([email])
  @@index([status])
  @@index([salesStage])
  @@index([country])
  @@index([product])
  @@index([createdAt])
}

model InquiryStatusHistory {
  id          String         @id @default(cuid())
  inquiryId   String
  oldStatus   InquiryStatus?
  newStatus   InquiryStatus
  changedById String?
  createdAt   DateTime       @default(now())
  changedBy   Admin?         @relation(fields: [changedById], references: [id])
  inquiry     Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
}

model BillingProviderConfig {
  id          String             @id @default(cuid())
  environment BillingEnvironment
  /// *
  /// * Provider registry key.
  /// * Examples:
  /// * TEST
  /// * RAZORPAY
  /// * STRIPE
  /// * PAYPAL
  provider    String
  /// *
  /// * Administrator-controlled availability.
  enabled     Boolean            @default(false)
  /// *
  /// * Optional administrator-facing display name.
  displayName String?
  /// *
  /// * Controls ordering in the customer billing UI.
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([environment, provider])
  @@index([environment])
  @@index([environment, enabled])
  @@index([provider])
}

model InquiryNote {
  id          String   @id @default(cuid())
  inquiryId   String
  note        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   Admin?   @relation(fields: [createdById], references: [id])
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([createdAt])
}

model WhatsAppAttachment {
  id                String          @id @default(cuid())
  whatsappMessageId String
  mediaId           String
  createdAt         DateTime        @default(now())
  media             Media           @relation(fields: [mediaId], references: [id])
  whatsappMessage   WhatsAppMessage @relation(fields: [whatsappMessageId], references: [id], onDelete: Cascade)

  @@index([whatsappMessageId])
  @@index([mediaId])
}

model Admin {
  id                 String                 @id @default(cuid())
  name               String
  email              String                 @unique
  password           String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  isActive           Boolean                @default(true)
  lastLogin          DateTime?
  role               AdminRole              @default(SUPER_ADMIN)
  activities         Activity[]             @relation("ActivityPerformedBy")
  assignedFollowUps  FollowUp[]             @relation("AssignedFollowUps")
  completedFollowUps FollowUp[]             @relation("CompletedFollowUps")
  inquiryNotes       InquiryNote[]
  statusChanges      InquiryStatusHistory[]
  createdQuotes      Quote[]                @relation("QuoteCreatedBy")
  updatedQuotes      Quote[]                @relation("QuoteUpdatedBy")
}

model FollowUp {
  id               String             @id @default(cuid())
  inquiryId        String
  assignedToId     String?
  completedById    String?
  sequence         Int                @default(1)
  title            String
  description      String?
  notes            String?
  actionType       FollowUpActionType
  category         FollowUpCategory
  priority         FollowUpPriority   @default(MEDIUM)
  status           FollowUpStatus     @default(PENDING)
  result           FollowUpResult?
  scheduledAt      DateTime
  dueAt            DateTime?
  estimatedMinutes Int?
  actualMinutes    Int?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  parentFollowUpId String?
  assignedTo       Admin?             @relation("AssignedFollowUps", fields: [assignedToId], references: [id])
  completedBy      Admin?             @relation("CompletedFollowUps", fields: [completedById], references: [id])
  inquiry          Inquiry            @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  parentFollowUp   FollowUp?          @relation("FollowUpChain", fields: [parentFollowUpId], references: [id])
  childFollowUps   FollowUp[]         @relation("FollowUpChain")

  @@index([inquiryId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledAt])
  @@index([priority])
  @@index([category])
  @@index([parentFollowUpId])
}

model Product {
  id                   String                @id @default(cuid())
  sku                  String                @unique
  name                 String
  slug                 String                @unique
  shortDescription     String?
  description          String?
  category             String?
  origin               String?
  hsCode               String?
  defaultUnit          String
  minOrderQty          Decimal?              @db.Decimal(18, 3)
  maxOrderQty          Decimal?              @db.Decimal(18, 3)
  status               ProductStatus         @default(DRAFT)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  featuredImageId      String?
  featuredImage        Media?                @relation("ProductFeaturedImage", fields: [featuredImageId], references: [id])
  pricing              ProductPricing[]
  proformaInvoiceItems ProformaInvoiceItem[]
  quoteItems           QuoteItem[]

  @@index([status])
  @@index([category])
  @@index([name])
  @@index([featuredImageId])
}

model ProductPricing {
  id          String      @id @default(cuid())
  productId   String
  pricingType PricingType @default(FIXED)
  currency    String
  price       Decimal     @db.Decimal(18, 2)
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean     @default(true)
  remarks     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
}

model Quote {
  id              String           @id @default(cuid())
  quoteNumber     String           @unique
  inquiryId       String?
  companyName     String
  contactPerson   String
  email           String
  phone           String?
  country         String
  currency        String
  subtotal        Decimal          @default(0) @db.Decimal(18, 2)
  discount        Decimal          @default(0) @db.Decimal(18, 2)
  freight         Decimal          @default(0) @db.Decimal(18, 2)
  insurance       Decimal          @default(0) @db.Decimal(18, 2)
  tax             Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal          @default(0) @db.Decimal(18, 2)
  validityDays    Int              @default(15)
  status          QuoteStatus      @default(DRAFT)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  parentQuoteId   String?
  validUntil      DateTime?
  version         Int              @default(1)
  proformaInvoice ProformaInvoice?
  createdBy       Admin?           @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  inquiry         Inquiry?         @relation(fields: [inquiryId], references: [id])
  parentQuote     Quote?           @relation("QuoteRevisions", fields: [parentQuoteId], references: [id])
  revisions       Quote[]          @relation("QuoteRevisions")
  updatedBy       Admin?           @relation("QuoteUpdatedBy", fields: [updatedById], references: [id])
  items           QuoteItem[]

  @@index([quoteNumber])
  @@index([status])
  @@index([companyName])
  @@index([country])
  @@index([createdById])
  @@index([updatedById])
  @@index([parentQuoteId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String
  description String?
  quantity    Decimal  @db.Decimal(18, 3)
  unit        String
  unitPrice   Decimal  @db.Decimal(18, 2)
  lineTotal   Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([productId])
}

model ProformaInvoice {
  id             String                @id @default(cuid())
  piNumber       String                @unique
  quoteId        String                @unique
  issueDate      DateTime              @default(now())
  paymentDueDate DateTime?
  companyName    String
  contactPerson  String
  email          String
  phone          String?
  country        String
  currency       String
  subtotal       Decimal               @default(0) @db.Decimal(18, 2)
  discount       Decimal               @default(0) @db.Decimal(18, 2)
  freight        Decimal               @default(0) @db.Decimal(18, 2)
  insurance      Decimal               @default(0) @db.Decimal(18, 2)
  tax            Decimal               @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal               @default(0) @db.Decimal(18, 2)
  paymentTerms   String?
  incoterms      String?
  notes          String?
  status         ProformaInvoiceStatus @default(DRAFT)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  quote          Quote                 @relation(fields: [quoteId], references: [id])
  items          ProformaInvoiceItem[]

  @@index([quoteId])
  @@index([status])
  @@index([companyName])
  @@index([country])
  @@index([issueDate])
}

model ProformaInvoiceItem {
  id                String          @id @default(cuid())
  proformaInvoiceId String
  productId         String
  description       String?
  quantity          Decimal         @db.Decimal(18, 3)
  unit              String
  unitPrice         Decimal         @db.Decimal(18, 2)
  lineTotal         Decimal         @db.Decimal(18, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  product           Product         @relation(fields: [productId], references: [id])
  proformaInvoice   ProformaInvoice @relation(fields: [proformaInvoiceId], references: [id], onDelete: Cascade)

  @@index([proformaInvoiceId])
  @@index([productId])
}

model Activity {
  id            String             @id @default(cuid())
  /// Business entity type
  entityType    ActivityEntityType
  /// Entity primary key
  entityId      String
  /// Human-readable reference
  /// Examples:
  /// INQ-2026-000001
  /// QT-2026-000001
  entityNumber  String?
  /// Machine readable event
  action        String
  /// UI friendly title
  title         String
  /// Detailed description
  description   String?
  /// Additional event metadata
  metadata      Json?
  /// Who performed the action
  actorType     ActivityActorType  @default(ADMIN)
  /// Admin user (nullable for System / AI / Customer)
  performedById String?
  createdAt     DateTime           @default(now())
  performedBy   Admin?             @relation("ActivityPerformedBy", fields: [performedById], references: [id])

  @@index([entityType, entityId])
  @@index([entityNumber])
  @@index([action])
  @@index([actorType])
  @@index([performedById])
  @@index([createdAt])
}

model NumberSequence {
  id        String             @id @default(cuid())
  type      NumberSequenceType
  year      Int
  lastValue Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([type, year])
  @@index([type])
  @@index([year])
}

model Language {
  id               String               @id @default(cuid())
  /// ISO language code (en, hi, ar, fr)
  code             String               @unique
  /// Display name
  name             String
  /// Native language name
  nativeName       String?
  /// Default language
  isDefault        Boolean              @default(false)
  /// Active language
  isActive         Boolean              @default(true)
  /// Display order
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  pageTranslations CmsPageTranslation[]

  @@index([isActive])
  @@index([sortOrder])
}

model CmsPage {
  id              String               @id @default(cuid())
  /// Internal page title
  title           String
  /// URL slug
  slug            String               @unique
  /// Page status
  status          CmsPageStatus        @default(DRAFT)
  /// Homepage flag
  isHomePage      Boolean              @default(false)
  /// Navigation visibility
  showInMenu      Boolean              @default(true)
  /// SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  /// Publishing
  publishedAt     DateTime?
  /// Audit
  createdById     String?
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  /// Page rendering template
  template        CmsPageTemplate      @default(STANDARD)
  /// Public page presentation shell
  layout          CmsPageLayout        @default(WEBSITE)
  translations    CmsPageTranslation[]
  menuItems       MenuItem[]

  @@index([status])
  @@index([slug])
  @@index([publishedAt])
  @@index([showInMenu])
}

model CmsPageTranslation {
  id                String   @id @default(cuid())
  pageId            String
  languageId        String
  /// Localized page content
  title             String
  slug              String
  excerpt           String?
  content           String?
  /// SEO
  metaTitle         String?
  metaDescription   String?
  metaKeywords      String?
  /// Publishing
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  /// Structured CMS landing-page content
  structuredContent Json?
  language          Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  page              CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, languageId])
  @@unique([languageId, slug])
  @@index([pageId])
  @@index([languageId])
  @@index([slug])
  @@index([isPublished])
}

model Media {
  id                  String               @id @default(cuid())
  /// Original filename
  fileName            String
  /// Stored filename
  storedFileName      String
  /// Public URL or relative path
  fileUrl             String
  /// Storage provider (local, s3, cloudinary, etc.)
  storageProvider     String?              @default("local")
  /// MIME type
  mimeType            String?
  /// IMAGE / VIDEO / DOCUMENT / AUDIO / OTHER
  mediaType           MediaType
  /// File size in bytes
  fileSize            Int?
  /// Image dimensions
  width               Int?
  height              Int?
  /// Optional alt text
  altText             String?
  /// Optional title
  title               String?
  /// Optional description
  description         String?
  /// Folder/category
  folder              String?
  /// Soft delete
  isDeleted           Boolean              @default(false)
  /// Audit
  uploadedById        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  featuredInProducts  Product[]            @relation("ProductFeaturedImage")
  whatsAppAttachments WhatsAppAttachment[]

  @@index([mediaType])
  @@index([folder])
  @@index([isDeleted])
  @@index([createdAt])
}

model Menu {
  id          String     @id @default(cuid())
  /// Internal menu name
  name        String
  /// Unique menu identifier
  code        String     @unique
  /// Description
  description String?
  /// Active menu
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@index([isActive])
}

model MenuItem {
  id           String     @id @default(cuid())
  menuId       String
  /// Parent item for dropdowns
  parentId     String?
  /// Display label
  label        String
  /// URL
  url          String
  /// Optional linked CMS page
  pageId       String?
  /// Display order
  sortOrder    Int        @default(0)
  /// Open in new tab
  openInNewTab Boolean    @default(false)
  /// Visibility
  isVisible    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  page         CmsPage?   @relation(fields: [pageId], references: [id])
  parent       MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuHierarchy")

  @@index([menuId])
  @@index([parentId])
  @@index([pageId])
  @@index([sortOrder])
  @@index([isVisible])
}

model SiteSetting {
  id          String   @id @default(cuid())
  /// Unique configuration key
  key         String   @unique
  /// Configuration value
  value       String?
  /// Category (General, SEO, Contact, Social, etc.)
  category    String?
  /// Description for administrators
  description String?
  /// Data type
  /// text, number, boolean, json
  valueType   String   @default("text")
  /// Publicly accessible setting
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublic])
}

model Redirect {
  id           String       @id @default(cuid())
  /// Old URL
  fromPath     String       @unique
  /// New URL
  toPath       String
  /// Permanent or Temporary
  redirectType RedirectType @default(PERMANENT)
  /// Active redirect
  isActive     Boolean      @default(true)
  /// Optional remarks
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([isActive])
  @@index([redirectType])
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  identities      AuthIdentity[]
  memberships     Membership[]

  @@index([isActive])
}

model AuthIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

model Tenant {
  id                           String                        @id @default(cuid())
  name                         String
  slug                         String                        @unique
  isActive                     Boolean                       @default(true)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  billingCustomer              BillingCustomer?
  businessAddress              BusinessAddress?
  businessProfile              BusinessProfile?
  businessContactCommunication BusinessContactCommunication?
  businessExportCredentials    BusinessExportCredentials?
  businessTaxCompliance        BusinessTaxCompliance?
  businessFinancialSettings    BusinessFinancialSettings?
  businessOperatingPreferences BusinessOperatingPreferences?
  memberships                  Membership[]
  payments                     Payment[]
  subscriptions                Subscription[]
  planChanges                  SubscriptionPlanChange[]

  @@index([isActive])
}

model BusinessProfile {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  businessName String
  legalName    String?
  businessType String?
  email        String?
  phone        String?
  country      String?
  website      String?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([businessName])
}

model BusinessAddress {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  addressLine1 String
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([country])
  @@index([state])
  @@index([city])
}

// ============================================================
// ROOTYM Business Contact & Communication
// Author: Prem Singh
// Purpose: Stores tenant-scoped business contact, communication,
//          social media and online business presence details.
// ============================================================

model BusinessContactCommunication {
  id       String @id @default(cuid())
  tenantId String @unique

  // Business Email
  primaryEmail    String?
  alternateEmail1 String?
  alternateEmail2 String?
  salesEmail      String?
  infoEmail       String?

  // Business Phone
  primaryPhone   String?
  alternatePhone String?
  whatsapp       String?

  // Social & Online Business Presence
  linkedinUrl       String?
  facebookUrl       String?
  instagramUrl      String?
  youtubeUrl        String?
  googleBusinessUrl String?
  xTwitterUrl       String?
  pinterestUrl      String?
  otherSocialUrls   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([primaryEmail])
  @@index([primaryPhone])
  @@index([whatsapp])
}

/**
 * ============================================================
 * ROOTYM Business Export Credentials
 * ============================================================
 * Author: Prem Singh
 * Purpose: Stores tenant-scoped export, business registration,
 * regulatory credential and license information.
 * ============================================================
 */

model BusinessExportCredentials {
  id       String @id @default(cuid())
  tenantId String @unique

  // ==========================================================
  // IEC / DGFT
  // ==========================================================

  iecNumber      String?
  iecStatus      String?
  iecIssueDate   DateTime?
  dgftProfileUrl String?

  // ==========================================================
  // GST
  // ==========================================================

  gstin               String?
  gstStatus           String?
  gstRegistrationDate DateTime?

  // ==========================================================
  // UDYAM / MSME
  // ==========================================================

  udyamNumber           String?
  udyamStatus           String?
  udyamRegistrationDate DateTime?

  // ==========================================================
  // Authorized Dealer Code
  // ==========================================================

  adCode         String?
  adCodeStatus   String?
  adCodeBankName String?

  // ==========================================================
  // ICEGATE
  // ==========================================================

  icegateRegistrationId String?
  icegateStatus         String?

  // ==========================================================
  // RCMC
  // ==========================================================

  rcmcNumber           String?
  rcmcIssuingAuthority String?
  rcmcStatus           String?
  rcmcIssueDate        DateTime?
  rcmcExpiryDate       DateTime?

  // ==========================================================
  // Other License 1
  // ==========================================================

  otherLicense1Name       String?
  otherLicense1Number     String?
  otherLicense1Status     String?
  otherLicense1ExpiryDate DateTime?

  // ==========================================================
  // Other License 2
  // ==========================================================

  otherLicense2Name       String?
  otherLicense2Number     String?
  otherLicense2Status     String?
  otherLicense2ExpiryDate DateTime?

  // ==========================================================
  // Other License 3
  // ==========================================================

  otherLicense3Name       String?
  otherLicense3Number     String?
  otherLicense3Status     String?
  otherLicense3ExpiryDate DateTime?

  // ==========================================================
  // Additional Information
  // ==========================================================

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([iecNumber])
  @@index([gstin])
  @@index([udyamNumber])
  @@index([adCode])
  @@index([icegateRegistrationId])
  @@index([rcmcNumber])
}

/**
 * ============================================================
 * ROOTYM Business Tax & Compliance
 * ============================================================
 * Author: Prem Singh
 * Purpose: Stores tenant-scoped tax configuration, export tax
 * treatment, LUT/Bond information and compliance
 * preferences for the ROOTYM business workspace.
 * ============================================================
 */

model BusinessTaxCompliance {
  id       String @id @default(cuid())
  tenantId String @unique

  // ==========================================================
  // GST Configuration
  // ==========================================================

  gstRegistrationType String?
  gstExportTreatment  String?
  defaultTaxRate      Decimal? @db.Decimal(5, 2)
  taxNotes            String?

  // ==========================================================
  // LUT / Bond
  // ==========================================================

  lutBondStatus        String?
  lutBondNumber        String?
  lutBondFinancialYear String?
  lutBondIssueDate     DateTime?
  lutBondExpiryDate    DateTime?

  // ==========================================================
  // TDS
  // ==========================================================

  tdsApplicable Boolean @default(false)
  tdsNotes      String?

  // ==========================================================
  // TCS
  // ==========================================================

  tcsApplicable Boolean @default(false)
  tcsNotes      String?

  // ==========================================================
  // Compliance
  // ==========================================================

  complianceStatus   String?
  nextComplianceDate DateTime?
  complianceNotes    String?

  // ==========================================================
  // Audit
  // ==========================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([lutBondNumber])
  @@index([nextComplianceDate])
  @@index([complianceStatus])
}

/**
 * ============================================================
 * ROOTYM Business Financial Settings
 * ============================================================
 * Author: Prem Singh
 * Purpose: Stores tenant-scoped financial configuration,
 * payment terms, beneficiary banking details and
 * foreign-remittance instructions for the business.
 * ============================================================
 */

model BusinessFinancialSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  // ==========================================================
  // Currency
  // ==========================================================

  baseCurrency           String?
  defaultInvoiceCurrency String?
  currencyNotes          String?

  // ==========================================================
  // Payment Terms
  // ==========================================================

  defaultPaymentTermsDays Int?
  defaultPaymentMethod    String?
  paymentTermsNotes       String?

  // ==========================================================
  // Beneficiary / Bank Details
  // ==========================================================

  beneficiaryName String?
  bankName        String?
  branchName      String?
  accountNumber   String?
  accountCurrency String?
  ifscCode        String?
  swiftBic        String?
  iban            String?
  bankAddress     String?
  bankCountry     String?

  // ==========================================================
  // Foreign Remittance Details
  // ==========================================================

  remittanceBankName     String?
  remittanceBankSwiftBic String?

  correspondentBankName     String?
  correspondentBankSwiftBic String?

  intermediaryBankName     String?
  intermediaryBankSwiftBic String?

  foreignBankAccountNumber String?
  foreignBankIban          String?
  routingOrSortCode        String?

  remittanceCurrency String?
  rbiPurposeCode     String?

  foreignRemittanceInstructions   String?
  remittanceReferenceInstructions String?

  bankChargesArrangement String?

  foreignRemittanceNotes String?

  // ==========================================================
  // Audit
  // ==========================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([baseCurrency])
  @@index([defaultInvoiceCurrency])
  @@index([bankName])
  @@index([swiftBic])
  @@index([remittanceCurrency])
  @@index([rbiPurposeCode])
}
/**
 * ============================================================
 * ROOTYM Business Operating Preferences
 * ============================================================
 * Author: Prem Singh
 * Purpose: Stores tenant-scoped operational, document,
 *          shipment, workflow and business working preferences.
 * ============================================================
 */

model BusinessOperatingPreferences {
  id       String @id @default(cuid())
  tenantId String @unique

  // Order & Export Operations
  defaultOrderProcessingPriority String?
  defaultShipmentMode             String?
  defaultIncoterm                 String?
  defaultPortOfLoading            String?
  defaultDestinationHandling      String?
  allowPartialShipment            Boolean @default(false)
  allowSplitShipment              Boolean @default(false)

  // Document Preferences
  defaultDocumentLanguage       String?
  documentNumberingPreference   String?
  invoiceNumberPrefix           String?
  quoteNumberPrefix             String?
  packingListNumberPrefix       String?
  shippingDocumentNumberPrefix  String?
  documentNotes                 String?

  // Shipment Preferences
  defaultTransportMode        String?
  defaultShipmentType        String?
  defaultPackageUnit         String?
  defaultWeightUnit          String?
  defaultDimensionUnit       String?
  shipmentHandlingInstructions String?

  // Communication & Workflow
  defaultCustomerCommunicationChannel String?
  internalApprovalRequired             Boolean @default(false)
  orderApprovalRequired                Boolean @default(false)
  shipmentApprovalRequired             Boolean @default(false)
  documentApprovalRequired             Boolean @default(false)
  workflowNotes                        String?

  // Business Working Preferences
  businessWorkingDays String?
  businessTimezone    String?
  defaultDateFormat   String?
  defaultNumberFormat String?
  operationalNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([defaultShipmentMode])
  @@index([defaultIncoterm])
  @@index([defaultTransportMode])
  @@index([businessTimezone])
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(OWNER)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([role])
}

model Plan {
  id              String                   @id @default(cuid())
  code            String                   @unique
  name            String
  description     String?
  trialDays       Int                      @default(0)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  amount          Int                      @default(0)
  billingInterval BillingInterval          @default(MONTHLY)
  currency        String                   @default("INR")
  razorpayPlanId  String?                  @unique
  type            PlanType                 @default(PAID)
  subscriptions   Subscription[]
  planChangesFrom SubscriptionPlanChange[] @relation("PlanChangeFromPlan")
  planChangesTo   SubscriptionPlanChange[] @relation("PlanChangeToPlan")

  @@index([isActive])
  @@index([type])
  @@index([billingInterval])
  @@index([currency])
}

model Subscription {
  id                     String                   @id @default(cuid())
  tenantId               String
  planId                 String
  status                 SubscriptionStatus       @default(TRIALING)
  startedAt              DateTime                 @default(now())
  trialStartedAt         DateTime?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  amount                 Int?
  billingInterval        BillingInterval?
  currency               String?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?                  @unique
  razorpayCurrentEnd     DateTime?
  razorpayCurrentStart   DateTime?
  razorpayEndAt          DateTime?
  razorpayStartAt        DateTime?
  payments               Payment[]
  plan                   Plan                     @relation(fields: [planId], references: [id])
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planChanges            SubscriptionPlanChange[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@index([trialEndsAt])
  @@index([razorpayCustomerId])
}

/// *
/// * Author: Prem Singh
/// * Purpose: Stores a paid future subscription plan change without changing the currently effective plan.
model SubscriptionPlanChange {
  id                     String           @id @default(cuid())
  tenantId               String
  subscriptionId         String
  fromPlanId             String
  toPlanId               String
  effectiveAt            DateTime
  status                 PlanChangeStatus @default(PAYMENT_PENDING)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  razorpaySubscriptionId String?
  upcomingPeriodEnd      DateTime?
  upcomingPeriodStart    DateTime?
  razorpayCurrentEnd     DateTime?
  razorpayCurrentStart   DateTime?
  razorpayEndAt          DateTime?
  razorpayStartAt        DateTime?
  payments               Payment[]
  fromPlan               Plan             @relation("PlanChangeFromPlan", fields: [fromPlanId], references: [id])
  subscription           Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toPlan                 Plan             @relation("PlanChangeToPlan", fields: [toPlanId], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([razorpaySubscriptionId])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@index([effectiveAt])
  @@index([status])
}

model BillingCustomer {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  provider           String   @default("RAZORPAY")
  providerCustomerId String   @unique
  email              String?
  name               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([provider])
}

model Payment {
  id                     String                  @id @default(cuid())
  tenantId               String
  subscriptionId         String?
  provider               String                  @default("RAZORPAY")
  providerPaymentId      String                  @unique
  providerOrderId        String?
  providerInvoiceId      String?
  providerSubscriptionId String?
  amount                 Int
  currency               String                  @default("INR")
  status                 PaymentStatus           @default(CREATED)
  paidAt                 DateTime?
  failedAt               DateTime?
  failureCode            String?
  failureReason          String?
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  planChangeId           String?
  planChange             SubscriptionPlanChange? @relation(fields: [planChangeId], references: [id])
  subscription           Subscription?           @relation(fields: [subscriptionId], references: [id])
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([planChangeId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerInvoiceId])
  @@index([providerSubscriptionId])
}

model BillingWebhookEvent {
  id           String               @id @default(cuid())
  provider     String               @default("RAZORPAY")
  eventId      String               @unique
  eventType    String
  status       BillingWebhookStatus @default(RECEIVED)
  payload      Json
  processedAt  DateTime?
  errorMessage String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([provider])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
}

